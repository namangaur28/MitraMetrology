# Database Configuration
DB_USER=user
DB_PASSWORD=password
DB_NAME=sih_compliance_db

# Backend Environment
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000/api

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png

# Image Processing
IMG_MAX_WIDTH=1920
IMG_MAX_HEIGHT=1080
IMG_QUALITY=85

# OCR
OCR_LANGUAGE=en
